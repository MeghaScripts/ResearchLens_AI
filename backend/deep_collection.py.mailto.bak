"""
Deep, exhaustive-collection research pipeline.

Architecture: 16 INDEPENDENT SOURCES. Every source (Semantic Scholar,
OpenAlex, Crossref, arXiv, PubMed, Europe PMC, DOAJ, ERIC, Internet
Archive, INSPIRE-HEP, IEEE Xplore, Springer Nature, CORE, ScienceDirect,
DBLP, NASA ADS) runs its own search -> collect-metadata -> score
pipeline with no dependency on any other source succeeding. OpenAlex and
Semantic Scholar are two of the 16 independent sources in their own
right, not mandatory enrichment services every other source is routed
through — a source that doesn't expose a citation count (DBLP, ERIC,
Internet Archive, ...) simply scores itself on whatever real signals it
DOES have (recency, venue, FWCI if a peer citation-count exists in this
run's own corpus, etc.), with weights renormalized to what's actually
available (see COMPONENT_WEIGHTS / compute_impact_score below) — never a
fabricated stand-in for a missing signal.

This implements the two-stage "collect from every source -> rank -> keep
the best 100 per source -> combine -> rank again -> keep the best 500
overall" pipeline. It never talks to a live academic API itself except
for Europe PMC's cursor pager below — every paper it sees comes from the
same real, no-fake-data fetch functions already used elsewhere in this
app (academic_sources.py + the default-3 fetchers in app.py). This module
only adds pagination loops and impact scoring around them.

  Stage 0 (per source): page through that source's results for the topic
    until the source itself runs out of matches, a per-source safety cap
    is hit, or pagination stalls (see PER_SOURCE_CAP's docstring below for
    why an unbounded "download the entire literature" isn't something a
    single request can honestly promise). Right after Stage 0, an OPTIONAL
    citation-count BACKFILL pass (see backfill_citation_counts below)
    looks up real citation counts, via Semantic Scholar's batch API, for
    every paper whose own source didn't report one. This is enrichment,
    not a dependency: every batch call is caught and logged individually,
    so a Semantic Scholar outage never blocks or fails a source — those
    papers are simply scored on recency alone instead (see Level 1 below).
  Stage 1 (per source — "Level 1: source-specific Impact Score"): score
    every paper collected FROM THAT SOURCE with compute_impact_score()
    using only the real signals present on that paper's own record, sort
    highest-first, keep the top STAGE1_TOP_N (100) from that source alone.
  Stage 2 (combined — "Level 2: common global Impact Score"): merge every
    source's stage-1 top-100 list, deduplicate by normalized title
    (keeping the highest-scoring instance of any paper indexed by more
    than one source, and recording every source that indexed it under
    `also_indexed_by`), recompute impact score + rank/percentile now that
    the full combined pool exists, sort highest-first, keep the top
    STAGE2_TOP_N (500). Because every paper from every source is scored
    with the exact same weight table (COMPONENT_WEIGHTS), Stage 1 and
    Stage 2 scores are already on one common 0-100 scale — an 84 from
    IEEE Xplore and an 84 from PubMed represent the same weighted mix of
    real evidence, so ranking them together is a fair, apples-to-apples
    comparison rather than mixing incompatible per-source metrics.
"""
import os
import re
import time
import math
import difflib
import datetime as _dt
import threading
import requests
from collections import Counter
from concurrent.futures import ThreadPoolExecutor, wait

from academic_sources import fetch_europe_pmc_page
import provenance

STAGE1_TOP_N = 100
STAGE2_TOP_N = 500

# ─── Speed / size limits ─────────────────────────────────────────────
#
# Stage 0 used to page every source one after another, up to 500 pages
# and 50,000 papers each, per query. Only the top 100 papers per source
# (STAGE1_TOP_N) and the top 500 overall (STAGE2_TOP_N) are ever used,
# so most of that time went into papers that were discarded. Sources
# also ran one at a time, so the total was the SUM of every source's
# paging time, which blew through the 120 s gunicorn timeout.
#
# Now: (1) every source is collected in PARALLEL, (2) each source has a
# page cap, a paper cap and a wall-clock budget, (3) the whole stage has
# a wall-clock budget, after which still-running sources are stopped
# and whatever they already collected is kept. Search APIs return
# results relevance-ranked, so the first few hundred hits per source
# are the ones that matter for impact ranking.
#
# Callers pick a preset with the request's "speed" field:
#   fast        (default) ~500 papers/source, 5 pages, ~35 s for Stage 0
#   balanced    ~1000 papers/source, 10 pages, ~55 s for Stage 0
#   exhaustive  the previous near-unbounded behaviour (can take many minutes)
# DEEP_COLLECTION_SPEED changes the default, and the older
# DEEP_COLLECTION_PER_SOURCE_CAP / DEEP_COLLECTION_MAX_PAGES env vars
# still override the preset's values when set.
def _env_int(name):
    raw = os.environ.get(name)
    try:
        return int(raw) if raw not in (None, '') else None
    except ValueError:
        return None


PAGE_SIZE = 100
# Kept for backward compatibility with code/tests that import them;
# these are the "exhaustive" values. Presets below are what a normal
# run uses.
PER_SOURCE_CAP = _env_int('DEEP_COLLECTION_PER_SOURCE_CAP') or 50000
MAX_PAGES = _env_int('DEEP_COLLECTION_MAX_PAGES') or 500

DEEP_SPEED_PRESETS = {
    'fast': {
        'per_source_cap': 500, 'max_pages': 5, 'max_queries': 3,
        'source_budget_s': 25, 'total_budget_s': 35, 'backfill_budget_s': 10,
        'max_workers': 12,
        'verify_network_top_n': 50, 'full_text_top_n': 25,
    },
    'balanced': {
        'per_source_cap': 1000, 'max_pages': 10, 'max_queries': 4,
        'source_budget_s': 40, 'total_budget_s': 55, 'backfill_budget_s': 20,
        'max_workers': 12,
        'verify_network_top_n': 100, 'full_text_top_n': 50,
    },
    'exhaustive': {
        'per_source_cap': PER_SOURCE_CAP, 'max_pages': MAX_PAGES, 'max_queries': 50,
        'source_budget_s': 900, 'total_budget_s': 1200, 'backfill_budget_s': 600,
        'max_workers': 12,
        'verify_network_top_n': None, 'full_text_top_n': None,
    },
}
DEFAULT_SPEED = (os.environ.get('DEEP_COLLECTION_SPEED') or 'fast').strip().lower()
if DEFAULT_SPEED not in DEEP_SPEED_PRESETS:
    DEFAULT_SPEED = 'fast'


def resolve_limits(speed=None):
    """Returns the limits dict for a speed preset name (unknown or empty
    names fall back to the default preset). Env overrides for the paper
    cap and page cap apply on top of a non-exhaustive preset only when
    explicitly set."""
    name = (speed or DEFAULT_SPEED or 'fast')
    name = str(name).strip().lower()
    if name not in DEEP_SPEED_PRESETS:
        name = DEFAULT_SPEED
    limits = dict(DEEP_SPEED_PRESETS[name])
    limits['speed'] = name
    if name != 'exhaustive':
        env_cap = _env_int('DEEP_COLLECTION_PER_SOURCE_CAP')
        env_pages = _env_int('DEEP_COLLECTION_MAX_PAGES')
        if env_cap:
            limits['per_source_cap'] = env_cap
        if env_pages:
            limits['max_pages'] = env_pages
    return limits


class _Budget:
    """Wall-clock deadline plus a cooperative cancel flag. One per source
    (clock starts when that source actually begins running); the cancel
    event is shared across all sources so the orchestrator can stop
    stragglers once the whole stage is out of time."""

    def __init__(self, seconds=None, cancel_event=None):
        self.deadline = (time.monotonic() + seconds) if seconds else None
        self.cancel_event = cancel_event or threading.Event()
        self.cut_short = False

    def expired(self):
        if self.cancel_event.is_set() or (
                self.deadline is not None and time.monotonic() >= self.deadline):
            self.cut_short = True
            return True
        return False


BETWEEN_PAGE_DELAY = 0.4       # polite pause between pages of the same source
DBLP_PAGE_DELAY = 2.5          # DBLP resets connections on bursts (see app.py's venue path)

STRICT_VENUES = ('AAAI', 'NeurIPS', 'ICML', 'ICLR')

# name -> (pagination kwarg name, is the cursor 1-based?)
# These are the pagination params documented/confirmed for each API in
# academic_sources.py / app.py's fetch functions.
PAGINATION_SPEC = {
    'ArXiv':             ('offset', False),
    'Semantic Scholar':  ('offset', False),
    'OpenAlex':          ('page', True),
    'Crossref':          ('offset', False),
    'PubMed':            ('offset', False),
    'DOAJ':              ('page', True),
    'ERIC':              ('start', False),
    'Internet Archive':  ('page', True),
    'INSPIRE-HEP':       ('page', True),
    'IEEE Xplore':       ('start_record', True),
    'Springer Nature':   ('start', True),
    'NASA ADS':          ('offset', False),
    'CORE':              ('offset', False),
    'ScienceDirect':     ('offset', False),
}


def _normalize_title(t):
    return re.sub(r'[^a-z0-9]+', ' ', (t or '').lower()).strip()


def _paper_year(p):
    try:
        return int(str(p.get('year', '')).strip()[:4])
    except (ValueError, TypeError):
        return None


class PaperDeduper:
    """
    Implements a DOI -> exact-title -> fuzzy-title -> author+year+title
    dedup chain (in that priority order), used both within a single
    source's own paginated results and across sources when Stage 2
    combines every source's shortlist.

    Every tier is a real string/identifier comparison — nothing
    fabricated. When two records ARE the same paper, `add_or_merge`
    folds in whichever fields the earlier record was missing (a DOI
    found on one source's copy, a citation_count from another) rather
    than silently keeping whichever copy happened to arrive first, and
    tracks every source that indexed the paper under `also_indexed_by`
    — an honest corroboration signal aggregated from real data, not an
    invented one.
    """
    TITLE_SIMILARITY_THRESHOLD = 0.93
    _MERGE_FIELDS = ('doi', 'citation_count', 'citation_count_source', 'venue',
                      'abstract', 'year', 'keywords_native', 'pmcid', 'is_open_access',
                      'core_id', 'arxiv_id', 'citation_percentile_band',
                      'reference_titles', 'openalex_id', 'referenced_works',
                      'author_ids_ss', 'author_ids_openalex', 'institution_ids_openalex',
                      # Needed by paper_verification: a PubMed record's
                      # PublicationType list (and its PMID) must survive
                      # being merged into a copy from another source,
                      # otherwise the merged paper silently loses the
                      # only authoritative publication-type and
                      # retraction signal it had.
                      'publication_types_native', 'pmid',
                      'ss_id', 'dblp_key', 'inspire_id', 'isbn',
                      'author_max_works_count')

    def __init__(self):
        self._by_doi = {}
        self._by_title = {}
        self._by_author_year = {}
        # Cached character counts per indexed title, for the cheap
        # upper-bound prefilter in _fuzzy_title_match.
        self._title_counters = {}

    @staticmethod
    def _norm_doi(doi):
        d = (doi or '').strip().lower()
        d = re.sub(r'^https?://(dx\.)?doi\.org/', '', d)
        return d or None

    @staticmethod
    def _author_year_key(paper):
        """
        The title portion of this key is deliberately truncated to its
        first 5 words — this tier exists to catch a paper listed under
        slightly different trailing wording (subtitle differences,
        appended venue notes) rather than to be a second exact-title
        check. But that truncation must never be allowed to also drop
        the ONE thing that actually distinguishes two different papers:
        a number could just as easily fall inside the kept 5 words
        ("Part 2: A Study of...") as after them ("A Study of... Part
        2") — either way, the full title's digit sequence is folded
        into the key too, so any numeric difference anywhere in the
        title still produces a different key even when the leading
        words are identical.
        """
        year = _paper_year(paper)
        authors = paper.get('authors') or []
        first_author = (authors[0] if authors else '').strip()
        last_name = first_author.split()[-1].lower() if first_author else ''
        norm_title = _normalize_title(paper.get('title', ''))
        title_words = norm_title.split()[:5]
        digit_seq = ' '.join(re.findall(r'\d+', norm_title))
        if not (last_name and year and title_words):
            return None
        return f"{last_name}|{year}|{' '.join(title_words)}|{digit_seq}"

    @staticmethod
    def _corroborates(year, existing_year, authors, existing_authors):
        """True only if year and author-surname evidence agree (or are
        simply absent) on both sides, AND at least one of the two
        actually confirms a match — never on title similarity alone."""
        if year is not None and existing_year is not None and year != existing_year:
            return False  # contradicting years — definitely not the same paper
        if authors and existing_authors and not (authors & existing_authors):
            return False  # contradicting author sets — definitely not the same paper
        year_confirmed = year is not None and existing_year is not None and year == existing_year
        author_confirmed = bool(authors and existing_authors and (authors & existing_authors))
        return year_confirmed or author_confirmed

    def _fuzzy_title_match(self, title, paper):
        """
        Fuzzy title similarity ALONE is not safe corroboration — two
        genuinely distinct papers can have titles that differ by a
        single word or number (e.g. "...Task 3" vs "...Task 13", or
        "Part I" vs "Part II") and still score above the similarity
        threshold on a pure character-ratio comparison, even after the
        same author publishes more than one such paper in the same
        year (a very ordinary thing to happen — a numbered series,
        multiple workshop papers). So this tier requires ALL of:
          1. title ratio clears the similarity threshold,
          2. the titles' digit sequences are identical once non-digit
             characters are stripped out — real duplicate listings
             differ in punctuation/formatting, not in which number
             appears in the title, so ANY digit mismatch (Task 3 vs
             Task 13, Part I already differs with no digits though —
             see below) means "different paper", full stop, regardless
             of anything else,
          3. year and author-surname evidence corroborate (agree or are
             simply absent) with at least one of them positively
             confirming a match — never on title similarity alone.
        If all three don't line up, this tier declines to merge rather
        than guess: staying as two separate (possibly duplicate)
        entries is the safe failure mode, silently deleting a real
        distinct paper is not.
        """
        year = _paper_year(paper)
        authors = {(a or '').split()[-1].lower() for a in (paper.get('authors') or []) if a}
        title_digits = re.sub(r'\D+', ' ', title).split()
        title_counter = Counter(title)
        title_len = len(title)
        for existing_title, existing_paper in self._by_title.items():
            if abs(len(existing_title) - title_len) > 15:
                continue  # cheap pre-filter before the real comparison
            # difflib.SequenceMatcher.ratio() is the expensive step and this
            # loop used to run it against EVERY indexed title for EVERY new
            # paper (quadratic; ~15 s for 500 papers, minutes for the old
            # multi-thousand-paper collections). The ratio can never exceed
            # 2*(shared characters)/(len_a + len_b) - difflib's own
            # quick_ratio() bound - so any pair below the threshold on that
            # bound cannot pass the real check either. Skipping those pairs
            # changes no result, only the time taken.
            ec = self._title_counters.get(existing_title)
            if ec is None:
                ec = self._title_counters[existing_title] = Counter(existing_title)
            shared = sum((title_counter & ec).values())
            if 2.0 * shared / (title_len + len(existing_title)) < self.TITLE_SIMILARITY_THRESHOLD:
                continue
            if difflib.SequenceMatcher(None, title, existing_title).ratio() < self.TITLE_SIMILARITY_THRESHOLD:
                continue
            if title_digits != re.sub(r'\D+', ' ', existing_title).split():
                continue  # differing digit sequence — e.g. Task 3 vs Task 13 — treat as different papers
            existing_year = _paper_year(existing_paper)
            existing_authors = {(a or '').split()[-1].lower() for a in (existing_paper.get('authors') or []) if a}
            if self._corroborates(year, existing_year, authors, existing_authors):
                return existing_paper
        return None

    def find_existing(self, paper):
        doi = self._norm_doi(paper.get('doi'))
        if doi and doi in self._by_doi:
            return self._by_doi[doi]
        title = _normalize_title(paper.get('title'))
        if title:
            if title in self._by_title:
                return self._by_title[title]
            fuzzy = self._fuzzy_title_match(title, paper)
            if fuzzy is not None:
                return fuzzy
        ay_key = self._author_year_key(paper)
        if ay_key and ay_key in self._by_author_year:
            return self._by_author_year[ay_key]
        return None

    def _index(self, paper):
        doi = self._norm_doi(paper.get('doi'))
        if doi:
            self._by_doi[doi] = paper
        title = _normalize_title(paper.get('title'))
        if title:
            self._by_title[title] = paper
        ay_key = self._author_year_key(paper)
        if ay_key:
            self._by_author_year[ay_key] = paper

    def add_or_merge(self, paper):
        """Returns (kept_paper, is_new). `kept_paper` is either `paper`
        itself (new) or the pre-existing record it duplicates, now
        merged with any fields `paper` had that the existing record
        didn't."""
        existing = self.find_existing(paper)
        if existing is None:
            existing_src = paper.get('source')
            paper.setdefault('also_indexed_by', [existing_src] if existing_src else [])
            paper.setdefault('field_sources', (paper.get('field_sources') or {}))
            self._index(paper)
            return paper, True

        merged_fields = []
        for field in self._MERGE_FIELDS:
            if not existing.get(field) and paper.get(field):
                existing[field] = paper[field]
                merged_fields.append(field)
        # Core bibliographic fields (title/authors/year/venue/doi/
        # abstract/citation_count) aren't all in _MERGE_FIELDS above —
        # title/authors/venue/abstract are usually already present on
        # `existing` (the record wouldn't have matched otherwise), so
        # they're only actually copied when genuinely absent; doi and
        # citation_count already are in _MERGE_FIELDS. Checked
        # separately so field_sources stays accurate even for the
        # fields _MERGE_FIELDS doesn't cover.
        for field in provenance.PROVENANCE_FIELDS:
            if field in self._MERGE_FIELDS:
                continue
            if not existing.get(field) and paper.get(field):
                existing[field] = paper[field]
                merged_fields.append(field)
        provenance.merge_field_sources(existing, paper, merged_fields)
        provenance.refresh_best_identifier(existing)
        existing.setdefault('also_indexed_by', [existing.get('source')] if existing.get('source') else [])
        src = paper.get('source')
        if src and src not in existing['also_indexed_by']:
            existing['also_indexed_by'].append(src)
        self._index(existing)  # re-index in case this instance had a DOI the earlier one lacked
        return existing, False


# ─── Stage 0: page a single source to (near) exhaustion ───────────────

def collect_source_papers(name, fn, topic, deduper=None, collected=None, cap=None,
                          budget=None, max_pages=None):
    """Pages `fn` (a real fetch function, same signature/behavior as the
    ones in academic_sources.py / app.py) for `topic` until the source
    runs dry, `cap` is hit, or pagination stalls (a page adds zero new
    papers by the DOI/title/author+year dedup chain — guards against a
    pagination param that silently isn't advancing, safer than looping
    forever on a guess). Returns a deduplicated list of real papers (see
    PaperDeduper for the matching + field-merge logic).

    `deduper`/`collected`/`cap` are exposed so collect_source_papers_multi_query
    below can run this same per-source pager across several related
    search queries (see DomainUnderstandingAgent) while sharing ONE
    dedup pool and ONE combined cap for that source — a paper matching
    two different queries is still only counted once, and expansion
    queries widen recall without multiplying PER_SOURCE_CAP. Called
    with no args (the original single-query behavior), each defaults to
    a fresh deduper/list/the module's PER_SOURCE_CAP."""
    cap = PER_SOURCE_CAP if cap is None else cap
    max_pages = MAX_PAGES if max_pages is None else max_pages
    if budget is not None and budget.expired():
        return [] if collected is None else collected
    if name == 'Europe PMC':
        return _collect_europe_pmc(topic, deduper=deduper, collected=collected, cap=cap,
                                   budget=budget, max_pages=max_pages)
    if name.endswith('(via DBLP)'):
        return _collect_dblp_venue(name, fn, topic, deduper=deduper, collected=collected, cap=cap,
                                   budget=budget, max_pages=max_pages)

    spec = PAGINATION_SPEC.get(name)
    deduper = PaperDeduper() if deduper is None else deduper
    collected = [] if collected is None else collected
    if not spec:
        # Unknown source: no confirmed pagination param for it. Take one
        # honest single-page fetch rather than guess a param name that
        # might silently do nothing (or error) against a real API.
        try:
            papers = fn(topic, max_results=PAGE_SIZE)
        except Exception as e:
            print(f"deep_collection: {name} single-page fetch failed: {e}")
            return collected
        for p in papers or []:
            if not p.get('title'):
                continue
            provenance.stamp_provenance(p, name)
            kept, is_new = deduper.add_or_merge(p)
            if is_new:
                collected.append(kept)
        return collected

    kwarg, one_based = spec
    cursor = 1 if one_based else 0
    for _ in range(max_pages):
        if budget is not None and budget.expired():
            break
        try:
            papers = fn(topic, max_results=PAGE_SIZE, **{kwarg: cursor})
        except Exception as e:
            print(f"deep_collection: {name} paging stopped at {kwarg}={cursor}: {e}")
            break
        if not papers:
            break
        new_count = 0
        for p in papers:
            if not p.get('title'):
                continue
            provenance.stamp_provenance(p, name)
            kept, is_new = deduper.add_or_merge(p)
            if is_new:
                collected.append(kept)
                new_count += 1
        if len(collected) >= cap:
            break
        if new_count == 0:
            break  # pagination isn't advancing, or the source is exhausted
        if not one_based and len(papers) < PAGE_SIZE:
            break  # counter-style API told us that was its last (partial) page
        cursor += (1 if one_based else len(papers))
        time.sleep(BETWEEN_PAGE_DELAY)
    return collected[:cap]


def collect_source_papers_multi_query(name, fn, queries, cap=None, budget=None,
                                      max_pages=None, collected=None):
    """
    Runs collect_source_papers for this source across MULTIPLE related
    search queries — the original topic plus any LLM-suggested semantic
    variations from DomainUnderstandingAgent — sharing ONE PaperDeduper
    and ONE running `collected` list across all of them. A paper that
    matches more than one query is still only counted once (same dedup
    chain as everything else), and the combined total across every
    query still respects the same per-source cap as a single-query run:
    expansion queries widen RECALL, they never multiply the cap.

    `queries` with just one entry (no expansion) behaves identically to
    calling collect_source_papers(name, fn, queries[0]) directly.
    """
    cap = PER_SOURCE_CAP if cap is None else cap
    deduper = PaperDeduper()
    # `collected` may be supplied by the caller so that a source that is
    # stopped mid-way (time budget) still leaves its partial results
    # readable by the caller.
    collected = [] if collected is None else collected
    for q in queries:
        if not q or len(collected) >= cap:
            break
        if budget is not None and budget.expired():
            break
        collect_source_papers(name, fn, q, deduper=deduper, collected=collected, cap=cap,
                              budget=budget, max_pages=max_pages)
    return collected


def _collect_europe_pmc(topic, deduper=None, collected=None, cap=None, budget=None, max_pages=None):
    """Europe PMC pages via an opaque `nextCursorMark` token rather than a
    counter, so it gets its own loop using fetch_europe_pmc_page."""
    cap = PER_SOURCE_CAP if cap is None else cap
    deduper = PaperDeduper() if deduper is None else deduper
    collected = [] if collected is None else collected
    cursor = '*'
    max_pages = MAX_PAGES if max_pages is None else max_pages
    for _ in range(max_pages):
        if budget is not None and budget.expired():
            break
        papers, next_cursor = fetch_europe_pmc_page(topic, max_results=PAGE_SIZE, cursor_mark=cursor)
        if not papers:
            break
        new_count = 0
        for p in papers:
            if not p.get('title'):
                continue
            provenance.stamp_provenance(p, 'Europe PMC')
            kept, is_new = deduper.add_or_merge(p)
            if is_new:
                collected.append(kept)
                new_count += 1
        if len(collected) >= cap or new_count == 0 or not next_cursor or next_cursor == cursor:
            break
        cursor = next_cursor
        time.sleep(BETWEEN_PAGE_DELAY)
    return collected[:cap]


def _collect_dblp_venue(name, fn, topic, deduper=None, collected=None, cap=None,
                        budget=None, max_pages=None):
    """`fn` here is expected to be a partial/lambda over
    academic_sources.fetch_dblp_venue for one specific venue, called as
    fn(topic, max_results=.., first=..). Uses DBLP_PAGE_DELAY instead of
    BETWEEN_PAGE_DELAY — DBLP resets connections on quick repeated hits,
    same reason app.py's existing venue-search path pauses 2.5s between
    venues."""
    cap = PER_SOURCE_CAP if cap is None else cap
    deduper = PaperDeduper() if deduper is None else deduper
    collected = [] if collected is None else collected
    first = 0
    max_pages = MAX_PAGES if max_pages is None else max_pages
    for _ in range(max_pages):
        if budget is not None and budget.expired():
            break
        try:
            papers = fn(topic, max_results=PAGE_SIZE, first=first)
        except Exception as e:
            print(f"deep_collection: {name} paging stopped at first={first}: {e}")
            break
        if not papers:
            break
        new_count = 0
        for p in papers:
            if not p.get('title'):
                continue
            provenance.stamp_provenance(p, name)
            kept, is_new = deduper.add_or_merge(p)
            if is_new:
                collected.append(kept)
                new_count += 1
        if len(collected) >= cap or new_count == 0 or len(papers) < PAGE_SIZE:
            break
        first += len(papers)
        time.sleep(DBLP_PAGE_DELAY)
    return collected[:cap]


# ─── Citation backfill (this is what makes impact score reflect quality) ──

SS_BATCH_URL = "https://api.semanticscholar.org/graph/v1/paper/batch"
SS_BATCH_SIZE = 500        # Semantic Scholar's documented max ids per /paper/batch call
SS_BATCH_FIELDS = "citationCount"
SS_BATCH_DELAY = 1.0       # politeness pause between batches on the unkeyed tier


def _paper_external_id(paper):
    """Returns a Semantic-Scholar-recognized external-ID string for this
    paper if it has one, else None. DOI is preferred — most non-arXiv
    sources carry one; arXiv ID is the fallback for arXiv papers, which
    normally have no DOI of their own."""
    doi = (paper.get('doi') or '').strip()
    if doi:
        return f"DOI:{doi}"
    arxiv_id = (paper.get('arxiv_id') or '').strip()
    if arxiv_id:
        return f"ARXIV:{arxiv_id}"
    return None


def backfill_citation_counts(papers, batch_size=SS_BATCH_SIZE, budget=None):
    """
    Impact score is only as good as the citation data behind it — a
    recency-only fallback tells you a paper is new, not that it's good.
    This closes that gap for the sources that don't report a citation
    count of their own (PubMed, DOAJ, ERIC, Internet Archive, Springer
    Nature, CORE, arXiv, and DBLP-listed venue papers) by looking up a
    REAL citation count for each one via Semantic Scholar's free
    /paper/batch endpoint, keyed on the paper's DOI or arXiv ID — the
    same citation source already used natively for Semantic-Scholar
    papers, just applied retroactively here to papers that came from a
    source with no citation field of its own. Nothing is guessed: a
    paper with no DOI/arXiv ID, or one Semantic Scholar doesn't
    recognize, is left exactly as it was (still eligible for the
    recency-only fallback) rather than assigned a made-up number.

    Mutates `papers` in place. Any paper Semantic Scholar resolves gets
    `citation_count` filled in and `citation_count_source` set to
    'semantic_scholar_backfill' (kept distinct from a source's own
    native citation count so the basis stays traceable — see
    compute_impact_score below). Returns how many papers were
    successfully backfilled.

    This is a network call against Semantic Scholar's rate-limited
    unkeyed tier, so a batch failure is caught and logged rather than
    raised — those papers simply keep whatever score basis they already
    had; the rest of the pipeline still runs.
    """
    candidates = [p for p in papers if p.get('citation_count') is None]
    id_to_papers = {}
    for p in candidates:
        ext_id = _paper_external_id(p)
        if ext_id:
            id_to_papers.setdefault(ext_id, []).append(p)
    ids = list(id_to_papers.keys())
    if not ids:
        return 0

    filled = 0
    for i in range(0, len(ids), batch_size):
        if budget is not None and budget.expired():
            print("deep_collection: citation backfill stopped at its time budget "
                  f"({i}/{len(ids)} ids looked up); remaining papers keep recency-only scoring")
            break
        chunk = ids[i:i + batch_size]
        try:
            resp = requests.post(
                SS_BATCH_URL, params={'fields': SS_BATCH_FIELDS},
                json={'ids': chunk}, timeout=30,
            )
            resp.raise_for_status()
            results = resp.json()
        except Exception as e:
            print(f"deep_collection: citation backfill batch failed: {e}")
            continue
        for ext_id, result in zip(chunk, results):
            if not result:
                continue  # Semantic Scholar doesn't recognize this ID — left untouched
            cc = result.get('citationCount')
            if cc is None:
                continue
            for p in id_to_papers.get(ext_id, []):
                p['citation_count'] = cc
                p['citation_count_source'] = 'semantic_scholar_backfill'
                filled += 1
        if i + batch_size < len(ids):
            time.sleep(SS_BATCH_DELAY)
    return filled


# ─── Source credibility (qualitative, not a fabricated number) ────────

# What each source actually IS, as a matter of public record — not a
# numeric "credibility score" pretending to a precision no free data
# source can honestly back. Real peer-review status per source:
SOURCE_TIER = {
    'ArXiv':             'preprint (not peer-reviewed)',
    'Semantic Scholar':  'mixed (aggregator of peer-reviewed work and preprints)',
    'OpenAlex':          'mixed (aggregator of peer-reviewed work and preprints)',
    'Crossref':          'peer-reviewed (publisher-registered DOIs)',
    'PubMed':            'peer-reviewed (biomedical)',
    'Europe PMC':        'peer-reviewed (biomedical, mixed open-access)',
    'DOAJ':              'peer-reviewed (open-access journals only)',
    'ERIC':              'mixed (peer-reviewed and grey literature, education)',
    'Internet Archive':  'grey literature / archival text (not peer-reviewed)',
    'INSPIRE-HEP':       'mixed (peer-reviewed work and preprints, physics)',
    'IEEE Xplore':       'peer-reviewed (IEEE-published)',
    'Springer Nature':   'peer-reviewed (Springer-published)',
    'NASA ADS':          'mixed (peer-reviewed work and preprints, astrophysics)',
    'CORE':              'mixed (aggregator of open-access repositories)',
    'ScienceDirect':     'peer-reviewed (Elsevier-published)',
}


# ─── Venue influence (real, free OpenAlex per-venue stats) ─────────────

_VENUE_STATS_CACHE = {}


def _get_openalex_venue_stats(venue_name):
    """
    Looks up `venue_name` in OpenAlex's own free /sources index and
    returns its REAL 2-year mean citedness and h-index if — and only
    if — a source in the results has an EXACT (case-insensitive) name
    match. No fuzzy matching: attaching one journal's real stats to a
    different, similarly-named journal would itself be a form of
    fabrication, so an inexact match returns None rather than guess.
    Cached per venue name for the lifetime of the process (venue stats
    don't meaningfully change within a single run).
    """
    key = (venue_name or '').strip().lower()
    if not key:
        return None
    if key in _VENUE_STATS_CACHE:
        return _VENUE_STATS_CACHE[key]
    stats = None
    try:
        resp = requests.get(
            "https://api.openalex.org/sources",
            params={'search': venue_name, 'per_page': 5, 'mailto': 'research@example.com'},
            timeout=15,
        )
        resp.raise_for_status()
        for src in resp.json().get('results', []):
            if (src.get('display_name') or '').strip().lower() == key:
                ss = src.get('summary_stats') or {}
                two_yr = ss.get('2yr_mean_citedness')
                stats = {'two_yr_mean_citedness': two_yr, 'h_index': ss.get('h_index')}
                break
    except Exception as e:
        print(f"deep_collection: venue stats lookup failed for '{venue_name}': {e}")
    _VENUE_STATS_CACHE[key] = stats
    return stats


def enrich_with_venue_influence(papers):
    """
    Real per-venue signal for the flowchart's "journal/venue influence"
    and "conference influence" components: looks up each paper's venue
    in OpenAlex's own free /sources index (2-year mean citedness and
    h-index — a free-data analogue of what a paid journal-impact-factor
    subscription would give you, not a substitute claiming to BE one).
    Only runs on the (already much smaller) Stage-2 combined pool, not
    the full raw collection, to keep the number of venue lookups
    bounded. Mutates each paper in place with `venue_influence` (the
    real 2yr_mean_citedness) and `venue_h_index` when an exact venue
    match is found; leaves both unset otherwise — never a guessed value
    for a venue OpenAlex doesn't have on record under that exact name.
    """
    unique_venues = {p.get('venue') for p in papers if p.get('venue')}
    for venue in unique_venues:
        stats = _get_openalex_venue_stats(venue)
        if stats and stats.get('two_yr_mean_citedness') is not None:
            for p in papers:
                if p.get('venue') == venue:
                    p['venue_influence'] = stats['two_yr_mean_citedness']
                    if stats.get('h_index') is not None:
                        p['venue_h_index'] = stats['h_index']
    return papers


# ─── Author / institution influence (real, free APIs) ──────────────
#
# Real per-author and per-institution signal for the flowchart's
# "author / institution influence" impact-score component — deliberately
# scoped to only what's genuinely available for free without a paid
# subscription (Scopus Author Metrics, SciVal, etc.):
#
#   - Semantic Scholar's free /graph/v1/author/batch endpoint returns a
#     REAL, computed hIndex for any author it has an ID for — this app
#     already captures that ID (`author_ids_ss`) for the top 3 authors
#     of every Semantic-Scholar-sourced paper.
#   - OpenAlex's free /authors and /institutions endpoints return REAL
#     summary_stats (h_index, works_count, cited_by_count, and for
#     institutions, 2yr_mean_citedness) for any author/institution it
#     has an ID for — this app already captures those IDs
#     (`author_ids_openalex` / `institution_ids_openalex`) for the top 3
#     authors of every OpenAlex-sourced paper.
#
# Every OTHER source used here (Crossref, PubMed, DOAJ, ERIC, Internet
# Archive, INSPIRE-HEP, IEEE Xplore, Springer Nature, NASA ADS, CORE,
# ScienceDirect) reports author NAMES only, with no stable ID this app
# could look up an author-metrics record for — matching by name alone
# risks conflating two different people who share a name, which would
# make this WORSE than having no signal at all. Rather than do that,
# author/institution influence is simply absent (not zero, not
# estimated) for any paper whose source doesn't expose a real author ID.

SS_AUTHOR_BATCH_URL = "https://api.semanticscholar.org/graph/v1/author/batch"
SS_AUTHOR_BATCH_SIZE = 500     # Semantic Scholar's documented max ids per /author/batch call
SS_AUTHOR_BATCH_FIELDS = "hIndex"
SS_AUTHOR_BATCH_DELAY = 1.0    # politeness pause between batches on the unkeyed tier

OPENALEX_BATCH_SIZE = 50       # OpenAlex's documented max ids per pipe-separated OR filter


def _fetch_ss_author_h_index(author_ids):
    """
    Real h-index lookup via Semantic Scholar's free, unkeyed
    /author/batch endpoint. Returns {author_id: h_index} for every ID
    Semantic Scholar recognizes and has a computed hIndex for; an ID it
    doesn't recognize, or recognizes but has no hIndex for, is simply
    absent from the returned dict — never defaulted to 0.
    """
    result = {}
    ids = list(dict.fromkeys(a for a in author_ids if a))
    for i in range(0, len(ids), SS_AUTHOR_BATCH_SIZE):
        chunk = ids[i:i + SS_AUTHOR_BATCH_SIZE]
        try:
            resp = requests.post(
                SS_AUTHOR_BATCH_URL, params={'fields': SS_AUTHOR_BATCH_FIELDS},
                json={'ids': chunk}, timeout=30,
            )
            resp.raise_for_status()
            records = resp.json()
        except Exception as e:
            print(f"deep_collection: SS author-batch lookup failed: {e}")
            continue
        for author_id, record in zip(chunk, records):
            if record and record.get('hIndex') is not None:
                result[author_id] = record['hIndex']
        if i + SS_AUTHOR_BATCH_SIZE < len(ids):
            time.sleep(SS_AUTHOR_BATCH_DELAY)
    return result


def _fetch_openalex_author_stats(author_ids):
    """
    Real h-index lookup via OpenAlex's free /authors endpoint, batched
    using OpenAlex's documented pipe-separated OR filter
    (ids.openalex:ID1|ID2|...), up to OPENALEX_BATCH_SIZE per request.
    Returns {author_id: h_index} for every ID OpenAlex actually returns
    a summary_stats.h_index for; anything else is absent, not guessed.
    """
    result = {}
    works = {}
    ids = list(dict.fromkeys(a for a in author_ids if a))
    for i in range(0, len(ids), OPENALEX_BATCH_SIZE):
        chunk = ids[i:i + OPENALEX_BATCH_SIZE]
        try:
            resp = requests.get(
                "https://api.openalex.org/authors",
                params={'filter': 'ids.openalex:' + '|'.join(chunk),
                        'per_page': len(chunk), 'mailto': 'research@example.com'},
                timeout=15,
            )
            resp.raise_for_status()
            for rec in resp.json().get('results', []):
                oaid = (rec.get('id') or '').replace('https://openalex.org/', '')
                stats = rec.get('summary_stats') or {}
                h_index = stats.get('h_index')
                if oaid and h_index is not None:
                    result[oaid] = h_index
                # Real works_count from the same record — "does this
                # author have other publications" (doc section 13),
                # free on this already-made call.
                works_count = rec.get('works_count')
                if oaid and works_count is not None:
                    works[oaid] = works_count
        except Exception as e:
            print(f"deep_collection: OpenAlex author-batch lookup failed: {e}")
            continue
    return result, works


def _fetch_openalex_institution_stats(institution_ids):
    """
    Real 2-year-mean-citedness lookup via OpenAlex's free /institutions
    endpoint, same batched OR-filter pattern as
    _fetch_openalex_author_stats. Returns {institution_id: 2yr_mean_citedness}
    for every ID OpenAlex returns that stat for; absent otherwise.
    """
    result = {}
    ids = list(dict.fromkeys(i for i in institution_ids if i))
    for i in range(0, len(ids), OPENALEX_BATCH_SIZE):
        chunk = ids[i:i + OPENALEX_BATCH_SIZE]
        try:
            resp = requests.get(
                "https://api.openalex.org/institutions",
                params={'filter': 'ids.openalex:' + '|'.join(chunk),
                        'per_page': len(chunk), 'mailto': 'research@example.com'},
                timeout=15,
            )
            resp.raise_for_status()
            for rec in resp.json().get('results', []):
                oaid = (rec.get('id') or '').replace('https://openalex.org/', '')
                two_yr = (rec.get('summary_stats') or {}).get('2yr_mean_citedness')
                if oaid and two_yr is not None:
                    result[oaid] = two_yr
        except Exception as e:
            print(f"deep_collection: OpenAlex institution-batch lookup failed: {e}")
            continue
    return result


def enrich_with_author_influence(papers):
    """
    Sets `author_max_h_index` (real, highest known h-index among a
    paper's own authors), `author_max_works_count` (real, highest known
    OpenAlex works_count among a paper's own authors — a direct "does
    this author have other publications" signal, doc section 13) and
    `institution_influence` (real, highest known 2yr_mean_citedness
    among a paper's authors' institutions) on every paper in `papers`
    that has a real author/institution ID to look up — via Semantic
    Scholar's and OpenAlex's free author/institution-metrics APIs (see
    the three _fetch_* helpers above).
    Runs on the (already much smaller) Stage-2 combined pool, not the
    full raw collection, same reasoning as enrich_with_venue_influence:
    keeps the number of batched lookups bounded regardless of how many
    thousands of papers Stage 0 collected.

    A paper with authors from BOTH Semantic Scholar and OpenAlex takes
    the higher of the two real h-indices found (both are real
    measurements of the same underlying concept, just computed by
    different providers over different citation graphs) — never an
    average or a guess. A paper whose source exposed no real author ID
    at all (the majority of sources here — see module comment above)
    gets neither field set: absent, not zero, not estimated.

    Mutates and returns `papers`. Returns (papers_with_author_influence,
    papers_with_institution_influence) counts for caller-side reporting.
    """
    all_ss_ids = [aid for p in papers for aid in (p.get('author_ids_ss') or [])]
    all_oa_author_ids = [aid for p in papers for aid in (p.get('author_ids_openalex') or [])]
    all_oa_inst_ids = [iid for p in papers for iid in (p.get('institution_ids_openalex') or [])]

    ss_h_index = _fetch_ss_author_h_index(all_ss_ids) if all_ss_ids else {}
    oa_h_index, oa_works_count = (
        _fetch_openalex_author_stats(all_oa_author_ids) if all_oa_author_ids else ({}, {}))
    oa_inst_stats = _fetch_openalex_institution_stats(all_oa_inst_ids) if all_oa_inst_ids else {}

    author_count = 0
    institution_count = 0
    for p in papers:
        known = [ss_h_index[aid] for aid in (p.get('author_ids_ss') or []) if aid in ss_h_index]
        known += [oa_h_index[aid] for aid in (p.get('author_ids_openalex') or []) if aid in oa_h_index]
        if known:
            p['author_max_h_index'] = max(known)
            author_count += 1
        known_works = [oa_works_count[aid] for aid in (p.get('author_ids_openalex') or [])
                      if aid in oa_works_count]
        if known_works:
            p['author_max_works_count'] = max(known_works)

        inst_known = [oa_inst_stats[iid] for iid in (p.get('institution_ids_openalex') or [])
                      if iid in oa_inst_stats]
        if inst_known:
            p['institution_influence'] = max(inst_known)
            institution_count += 1

    return author_count, institution_count


# ─── Impact scoring ─────────────────────────────────────────────────

# ─── Weight-normalized, availability-aware component weights ──────────
#
# Each source produces its OWN score from whatever real signals it can
# obtain on its OWN paper record — no source has to call another
# source to score a paper it found. A source that only exposes
# title/authors/year/venue (say, DBLP or ERIC) still produces a
# complete, honestly-labeled score; it just does it from a smaller set
# of real components than a source that also exposes citation counts
# or author IDs. What makes scores from different sources comparable
# is that every paper — regardless of which of the 16 sources found it
# — is run through this SAME fixed weight table, and whichever
# components that particular paper actually has are re-normalized so
# they sum to 100%. A paper scored on 60% of the weight table (because
# 40% of it — say, citation + author influence — simply wasn't
# available for that source/paper) is scored purely on the 60% it
# does have, scaled up to fill 0-100; nothing is invented to cover the
# missing 40%.
#
# One of BASE_CITATION or BASE_RECENCY always applies (every paper has
# either a real citation count or a real publication year) and they
# share one weight slot, since they're two alternative ways of
# expressing the same "is this paper accumulating impact" base signal.
COMPONENT_WEIGHTS = {
    'base':                  0.35,   # citation_velocity OR recency_only (mutually exclusive)
    'fwci':                  0.15,   # corpus-relative Field-Weighted Citation Impact
    'citation_percentile':   0.10,   # OpenAlex citation_percentile_band, when present
    'venue_influence':       0.15,   # OpenAlex-matched venue 2yr mean citedness
    'author_influence':      0.15,   # Semantic Scholar / OpenAlex author h-index
    'institution_influence': 0.10,   # OpenAlex institution 2yr mean citedness
}
STRICT_VENUE_BONUS_PCT = 5.0  # fixed points added on the final 0-100 scale, on top of the weighted score


def compute_impact_score(paper, current_year=None):
    """
    Independent, source-agnostic impact score, 0-100, computed entirely
    from real signals already present on THIS paper's own record — this
    function never makes a network call and never depends on any other
    source having succeeded. It is the "Level 1 — source-specific
    Impact Score" step for whichever of the 16 sources this paper came
    from, and because every paper from every source runs through the
    exact same weight table (see COMPONENT_WEIGHTS above), the results
    are already the "Level 2 — Common Impact Score 0-100" that can be
    fairly ranked across sources — an 84 from IEEE Xplore and an 84
    from PubMed reflect the same weighted mix of real evidence, not two
    different unrelated scales.

    Components, each real and independently checkable:
      - `base`: citation VELOCITY (citations / years-since-publication)
        when this paper has a genuine `citation_count` — native from
        its own source (Semantic Scholar, OpenAlex, Crossref, Europe
        PMC, INSPIRE-HEP, IEEE Xplore, NASA ADS) or filled in via
        backfill_citation_counts()'s optional Semantic Scholar lookup —
        rewarding papers that accumulated impact quickly. When no
        citation count exists for this paper at all, `base` falls back
        to a recency-only proxy instead — an honestly weaker signal,
        flagged via `impact_score_basis`, never a citation count
        invented to fill the gap. Backfill is enrichment, not a
        dependency: if it never runs (or Semantic Scholar is
        unreachable), this paper is scored on recency alone rather than
        left unscored.
      - `fwci`: this run's own corpus-relative Field-Weighted Citation
        Impact (see compute_fwci_scores) — real only when this paper's
        source reported a citation count and at least one year-peer did
        too.
      - `citation_percentile`: OpenAlex's own `cited_by_percentile_year`
        band, when OpenAlex is one of the sources that indexed this
        paper.
      - `venue_influence`: OpenAlex's real per-venue 2yr mean citedness,
        when enrich_with_venue_influence() found an exact venue match.
      - `author_influence` / `institution_influence`: real author
        h-index / institution citedness, when Semantic Scholar or
        OpenAlex exposed an author/institution ID for this paper.

    Any component with no real data for this paper is left out
    entirely — never zero-filled — and the remaining components' weights
    are renormalized to sum to 100% before scaling, exactly as the
    architecture note's example: "Total available 60% → normalize to
    100% for that source/paper." A fixed, documented bonus
    (STRICT_VENUE_BONUS_PCT) is then added on top for the four
    real, independently-verifiable strict venues (AAAI/NeurIPS/ICML/
    ICLR), same as before.

    Mutates and returns `paper` with `impact_score` (float, 0-100+,
    higher = more impactful), `impact_score_basis` set to one of
    'citation_velocity' / 'citation_velocity_backfilled' / 'recency_only',
    and `impact_score_components` — a transparent breakdown of which
    real signals contributed, their raw values, and the weight each was
    actually given after renormalization.
    """
    current_year = current_year or _dt.datetime.now().year
    year = _paper_year(paper)
    age_years = max(1, (current_year - year + 1)) if year else None

    raw = {}       # component -> raw (unweighted, unbounded) signal strength, 0..~1 scale
    components = {}  # component -> {'value': raw signal, 'weight_pct': weight after renormalization}

    citation_count = paper.get('citation_count')
    try:
        citation_count = float(citation_count) if citation_count is not None else None
    except (ValueError, TypeError):
        citation_count = None

    if citation_count is not None and citation_count >= 0:
        velocity = (citation_count / age_years) if age_years else citation_count
        raw['base'] = math.log1p(citation_count) + math.log1p(velocity)
        basis = ('citation_velocity_backfilled'
                 if paper.get('citation_count_source') == 'semantic_scholar_backfill'
                 else 'citation_velocity')
    else:
        # No fabricated citation number — an honest, lower-confidence
        # recency-only proxy instead. Same weight slot as citation
        # velocity above: this paper's base signal, whichever real
        # evidence it actually has.
        raw['base'] = (1.0 / age_years) if age_years else 0.1
        basis = 'recency_only'

    # Real, corpus-relative FWCI — see compute_fwci_scores docstring.
    fwci = paper.get('fwci')
    if fwci is not None:
        raw['fwci'] = min(2.0, math.log1p(fwci))  # capped so one outlier year can't dominate

    percentile_band = paper.get('citation_percentile_band')
    if isinstance(percentile_band, dict) and percentile_band.get('min') is not None:
        mid = (percentile_band.get('min', 0) + percentile_band.get('max', percentile_band.get('min', 0))) / 2
        raw['citation_percentile'] = mid / 100.0

    venue_influence = paper.get('venue_influence')
    if venue_influence is not None and venue_influence >= 0:
        raw['venue_influence'] = math.log1p(venue_influence)

    # Real author-influence signal — only set on papers whose source
    # exposed a real author ID (Semantic Scholar and/or OpenAlex);
    # absent (not zero) for every other source/paper.
    author_h_index = paper.get('author_max_h_index')
    if author_h_index is not None and author_h_index >= 0:
        raw['author_influence'] = math.log1p(author_h_index)

    # Real institution-influence signal — same free OpenAlex
    # /institutions summary_stats used for venue_influence, keyed on
    # institution instead of venue.
    institution_influence = paper.get('institution_influence')
    if institution_influence is not None and institution_influence >= 0:
        raw['institution_influence'] = math.log1p(institution_influence)

    # A fixed reference scale per component turns each raw signal into
    # a 0-100-ish contribution before weighting, so components with
    # very different natural ranges (a velocity log-sum vs. a 0-1
    # percentile) don't silently dominate just because their raw
    # numbers happen to be larger.
    REFERENCE_SCALE = {
        'base': 5.0, 'fwci': 2.0, 'citation_percentile': 1.0,
        'venue_influence': 3.0, 'author_influence': 4.0, 'institution_influence': 3.0,
    }

    available_weight = sum(COMPONENT_WEIGHTS[c] for c in raw)
    score = 0.0
    if available_weight > 0:
        for component, value in raw.items():
            weight_pct = COMPONENT_WEIGHTS[component] / available_weight  # renormalized to sum to 1.0
            contribution_0_100 = min(1.0, value / REFERENCE_SCALE[component]) * 100
            score += contribution_0_100 * weight_pct
            components[component] = {
                'value': round(value, 4),
                'weight_pct': round(weight_pct * 100, 1),
            }

    venue_label = f"{paper.get('source', '')} {paper.get('venue', '')}"
    if any(v in venue_label for v in STRICT_VENUES):
        score += STRICT_VENUE_BONUS_PCT  # fixed, documented bonus — not a fabricated figure
        components['strict_venue_bonus'] = {'value': STRICT_VENUE_BONUS_PCT, 'weight_pct': None}

    paper['impact_score'] = round(score, 2)
    paper['impact_score_basis'] = basis
    paper['impact_score_components'] = components
    paper['impact_score_available_weight_pct'] = round(available_weight * 100, 1)
    return paper


def compute_fwci_scores(papers):
    """
    Sets a real `fwci` field on every paper in `papers`: its
    citation_count divided by the mean citation_count of all OTHER
    papers in this same corpus published the same year. This is the
    actual definition of Field-Weighted Citation Impact (observed
    citations ÷ expected citations for a paper's field+year+type) —
    here the collected corpus itself stands in for "the field", since
    every paper in it matched the same topic/domain search. Requires
    at least 2 papers with a known citation_count in a given year to
    compute a mean; years with fewer than that, or papers with no
    citation_count at all (native or backfilled), get `fwci = None` —
    never a fabricated ratio. Mutates and returns `papers`.
    """
    by_year = {}
    for p in papers:
        y = _paper_year(p)
        c = p.get('citation_count')
        if y is not None and c is not None:
            try:
                by_year.setdefault(y, []).append(float(c))
            except (ValueError, TypeError):
                continue
    year_mean = {y: (sum(cs) / len(cs)) for y, cs in by_year.items() if len(cs) >= 2}

    for p in papers:
        y = _paper_year(p)
        c = p.get('citation_count')
        mean = year_mean.get(y)
        if mean and mean > 0 and c is not None:
            try:
                p['fwci'] = round(float(c) / mean, 3)
            except (ValueError, TypeError):
                p['fwci'] = None
        else:
            p['fwci'] = None
    return papers


# ─── Stage 1 / Stage 2 ──────────────────────────────────────────────

def stage1_rank_and_shortlist(source_to_papers):
    """Level 1 — source-specific Impact Score. Per source: score every
    paper collected from it using only that paper's own real signals
    (no other source's success is required for this to run), sort
    highest-impact-first, keep the top STAGE1_TOP_N.
    Returns ({source: [papers...]}, {source: {'collected': n, 'shortlisted': n}})."""
    shortlisted, stats = {}, {}
    for source, papers in source_to_papers.items():
        compute_fwci_scores(papers)  # corpus-relative, computed per-source pool first
        for p in papers:
            compute_impact_score(p)
        ranked = sorted(papers, key=lambda p: p['impact_score'], reverse=True)
        shortlisted[source] = ranked[:STAGE1_TOP_N]
        stats[source] = {'collected': len(papers), 'shortlisted': len(shortlisted[source])}
    return shortlisted, stats


def stage2_combine_and_shortlist(stage1_result):
    """Level 2 — common global Impact Score. Merge every source's stage-1 shortlist using the same DOI ->
    title -> author+year dedup chain as Stage 0 (PaperDeduper), folding
    together any fields one source's copy had that another's didn't
    (a DOI here, a citation_count there) and recording every source
    that indexed a paper under `also_indexed_by`. Recomputes impact
    score now that the full combined — and more complete, post-merge —
    pool exists, sorts highest-first, keeps the top STAGE2_TOP_N, and
    stamps each surviving paper with its rank and percentile."""
    deduper = PaperDeduper()
    combined = []
    for papers in stage1_result.values():
        for p in papers:
            if not p.get('title'):
                continue
            kept, is_new = deduper.add_or_merge(p)
            if is_new:
                combined.append(kept)
            # else: merged into the existing record in place — no need to
            # add it again, compute_impact_score below re-scores the
            # now-more-complete record regardless of which instance survived

    # Recompute FWCI on the full combined pool now that merging has
    # filled in citation counts one source alone was missing — this is
    # the more accurate, final FWCI (larger per-year peer group), and
    # supersedes each paper's stage-1 (per-source-pool) fwci value.
    compute_fwci_scores(combined)
    for p in combined:
        compute_impact_score(p)  # recalculated on the now-combined, merged pool

    combined.sort(key=lambda p: p['impact_score'], reverse=True)
    n = len(combined)
    for rank, p in enumerate(combined, start=1):
        p['combined_rank'] = rank
        p['combined_percentile'] = round(100 * (n - rank + 1) / n, 1) if n else 0
    return combined[:STAGE2_TOP_N]


# ─── Top-level orchestration ────────────────────────────────────────

def run_two_stage_collection(topic, source_registry, progress_cb=None, extra_queries=None,
                             speed=None):
    """
    `source_registry`: {source_name: callable} built by the caller
    (app.py) from its own default-3 fetchers plus
    academic_sources.FREE_SOURCES / KEYED_SOURCES / any checked
    strict-venue DBLP streams. Every callable must accept
    `fn(topic, max_results=.., **pagination_kwarg)` and return a plain
    list of paper dicts — the exact same contract every fetch function
    in this app already follows. This module never talks to a live API
    directly except for Europe PMC's cursor pager, so app.py stays the
    single source of truth for how each API is actually called.

    `extra_queries`: optional list of additional real search-query
    strings (see DomainUnderstandingAgent's LLM-generated semantic
    variations / related terminology) run against every source
    alongside `topic`, sharing one dedup pool and cap per source (see
    collect_source_papers_multi_query) — this widens Stage-0 recall
    without multiplying the per-source cap or double-counting a paper
    that multiple queries turn up.

    `progress_cb`, if given, is called with a short string at the start
    of each stage (and once per source as it starts) — useful for
    streaming status to a caller.

    `speed`: 'fast' (default) / 'balanced' / 'exhaustive' — see
    DEEP_SPEED_PRESETS. Sources are collected in parallel under a
    per-source and a whole-stage time budget; the returned
    `collection_limits` says exactly which limits applied and which
    sources (if any) were stopped early, so a capped run is never
    presented as an exhaustive one.

    Returns a dict with the Stage-0 collection counts, how many papers
    the citation backfill pass filled in, Stage-1 per-source shortlist
    stats, the final Stage-2 top-(up to 500) paper list (each with
    `impact_score`, `impact_score_basis`, `combined_rank`,
    `combined_percentile` set), and which sources ended up with real
    citation data (native or backfilled) vs. still fell back to
    recency-only scoring — so the caller can be upfront about that
    limitation instead of presenting every score as equally
    well-evidenced.
    """
    limits = resolve_limits(speed)
    queries = ([topic] + [q for q in (extra_queries or []) if q and q.strip() and q.strip() != topic])
    queries = queries[:max(1, limits['max_queries'])]
    t_start = time.monotonic()
    cancel_event = threading.Event()

    # name -> {'collected': [...], 'budget': _Budget|None}. The list is
    # created here (not inside the worker) so partial results survive a
    # worker that has to be abandoned at the stage deadline.
    state = {name: {'collected': [], 'budget': None} for name in source_registry}

    def _collect_one(name, fn):
        budget = _Budget(limits['source_budget_s'], cancel_event)
        state[name]['budget'] = budget
        if progress_cb:
            progress_cb(f"Collecting from {name}...")
        collect_source_papers_multi_query(
            name, fn, queries, cap=limits['per_source_cap'], budget=budget,
            max_pages=limits['max_pages'], collected=state[name]['collected'])

    if progress_cb:
        progress_cb(f"Collecting from {len(source_registry)} sources in parallel "
                    f"({limits['speed']} mode)...")
    source_to_papers = {}
    sources_cut_short, sources_abandoned = [], []
    if source_registry:
        pool = ThreadPoolExecutor(max_workers=max(1, min(len(source_registry), limits['max_workers'])))
        futures = {pool.submit(_collect_one, name, fn): name for name, fn in source_registry.items()}
        # A little grace beyond the stage budget: workers check their
        # budget between pages, so one in-flight request may still finish.
        done, pending = wait(list(futures), timeout=limits['total_budget_s'] + 5)
        if pending:
            cancel_event.set()   # cooperative stop for anything still paging
        for fut, name in futures.items():
            if fut in done:
                try:
                    fut.result()
                except Exception as e:
                    print(f"deep_collection: {name} failed entirely: {e}")
            collected = state[name]['collected']
            # Snapshot (copying the dicts for abandoned workers, which may
            # still be merging into them) so later stages never race a
            # background thread.
            papers = list(collected) if fut in done else [dict(p) for p in list(collected)]
            if fut in pending:
                sources_abandoned.append(name)
            elif state[name]['budget'] is not None and state[name]['budget'].cut_short:
                sources_cut_short.append(name)
            if papers:
                source_to_papers[name] = papers
        try:
            pool.shutdown(wait=False, cancel_futures=True)
        except TypeError:   # Python < 3.9 has no cancel_futures
            pool.shutdown(wait=False)
    t_collected = time.monotonic()
    if sources_cut_short or sources_abandoned:
        print("deep_collection: stopped at time budget — cut short: "
              f"{sources_cut_short}, abandoned: {sources_abandoned}")

    if progress_cb:
        progress_cb("Backfilling citation counts for sources with no native citation data...")
    all_collected = [p for papers in source_to_papers.values() for p in papers]
    backfill_budget = _Budget(limits['backfill_budget_s'])
    citations_backfilled = backfill_citation_counts(all_collected, budget=backfill_budget)
    t_backfilled = time.monotonic()

    stage1_result, stage1_stats = stage1_rank_and_shortlist(source_to_papers)
    stage2_papers = stage2_combine_and_shortlist(stage1_result)

    t_shortlisted = time.monotonic()
    if progress_cb:
        progress_cb("Looking up real per-venue impact stats (OpenAlex)...")
    enrich_with_venue_influence(stage2_papers)
    if progress_cb:
        progress_cb("Looking up real author/institution influence (Semantic Scholar + OpenAlex)...")
    authors_enriched, institutions_enriched = enrich_with_author_influence(stage2_papers)
    for p in stage2_papers:
        compute_impact_score(p)  # re-scored now that venue_influence/citation_percentile may be set
    stage2_papers.sort(key=lambda p: p['impact_score'], reverse=True)
    n = len(stage2_papers)
    for rank, p in enumerate(stage2_papers, start=1):
        p['combined_rank'] = rank
        p['combined_percentile'] = round(100 * (n - rank + 1) / n, 1) if n else 0
        p['source_tier'] = SOURCE_TIER.get(p.get('source', '').split(' (via DBLP)')[0]) \
            or ('peer-reviewed (top-tier conference via DBLP)' if '(via DBLP)' in (p.get('source') or '') else 'unclassified')

    basis_by_source = {
        name: sorted({p.get('impact_score_basis') for p in papers})
        for name, papers in source_to_papers.items()
    }
    has_citation_data = lambda bases: any(b in ('citation_velocity', 'citation_velocity_backfilled') for b in bases)

    t_done = time.monotonic()
    collection_limits = {
        'speed': limits['speed'],
        'per_source_cap': limits['per_source_cap'],
        'max_pages_per_query': limits['max_pages'],
        'max_queries': limits['max_queries'],
        'source_budget_seconds': limits['source_budget_s'],
        'total_budget_seconds': limits['total_budget_s'],
        # Sources that hit their time budget and kept what they had so far.
        'sources_cut_short_by_time': sorted(sources_cut_short),
        # Sources still running at the stage deadline that were stopped.
        'sources_stopped_at_stage_deadline': sorted(sources_abandoned),
        'citation_backfill_cut_short': bool(backfill_budget.cut_short),
        'is_exhaustive': limits['speed'] == 'exhaustive',
        'seconds': {
            'source_collection': round(t_collected - t_start, 1),
            'citation_backfill': round(t_backfilled - t_collected, 1),
            'ranking_and_shortlist': round(t_shortlisted - t_backfilled, 1),
            'venue_author_enrichment': round(t_done - t_shortlisted, 1),
            'stage_total': round(t_done - t_start, 1),
        },
    }
    print(f"deep_collection: stage timings {collection_limits['seconds']}")

    return {
        'topic': topic,
        'queries_used': queries,
        'collection_limits': collection_limits,
        'stage0_stats': {name: len(papers) for name, papers in source_to_papers.items()},
        'stage1_stats': stage1_stats,
        'stage2_papers': stage2_papers,
        'stage2_count': len(stage2_papers),
        'sources_queried': list(source_to_papers.keys()),
        'citations_backfilled': citations_backfilled,
        'sources_with_citation_data': sorted(n for n, b in basis_by_source.items() if has_citation_data(b)),
        'sources_recency_only': sorted(n for n, b in basis_by_source.items() if not has_citation_data(b)),
        'authors_with_influence_data': authors_enriched,
        'institutions_with_influence_data': institutions_enriched,
    }


# ─── Keyword-trend stats for the gap-detection step ────────────────

STOPWORDS_FALLBACK = {
    'this', 'that', 'with', 'from', 'have', 'been', 'were', 'their',
    'which', 'these', 'also', 'such', 'into', 'more', 'than', 'when',
    'while', 'about', 'based', 'using', 'used', 'paper', 'study',
    'results', 'method', 'approach',
}


def _text_tokens(plist, stopwords):
    """Real word/bigram counts from title+abstract, merged with any
    curated native keywords/subjects the source itself supplied (see
    `keywords_native` on paper dicts — OpenAlex concepts, INSPIRE-HEP
    keywords, Crossref/DOAJ subjects, Semantic Scholar fieldsOfStudy).
    Native keywords are real, source-curated terms, counted once per
    paper rather than re-derived from free text."""
    counts = Counter()
    for p in plist:
        text = (p.get('title', '') + ' ' + p.get('abstract', '')).lower()
        words = re.findall(r'\b[a-z]{4,}\b', text)
        filtered = [w for w in words if w not in stopwords]
        bigrams = [filtered[i] + ' ' + filtered[i + 1] for i in range(len(filtered) - 1)]
        counts.update(filtered)
        counts.update(bigrams)
        for kw in (p.get('keywords_native') or []):
            kw = (kw or '').strip().lower()
            if kw:
                counts[kw] += 1
    return counts


def _term_present(term, paper):
    text = (paper.get('title', '') + ' ' + paper.get('abstract', '')).lower()
    if term in text:
        return True
    native = {(kw or '').strip().lower() for kw in (paper.get('keywords_native') or [])}
    return term in native


def keyword_trend_stats(papers, stopwords=None, top_n=25):
    """
    Buckets the combined Stage-2 paper pool into 'recent' (papers from
    the most recent calendar year present, plus the year before it) vs
    'established' (everything older), extracts frequent title/abstract/
    native-keyword terms per bucket with real word-frequency counts (no
    LLM guessing), and returns:

      - RISING terms (frequent in recent papers, rare/absent in
        established ones) vs ENTRENCHED (frequent in both) vs DECLINING
        (frequent in established, absent from the recent top list) —
        all a real frequency-shift signal computed from the collected
        papers, not an LLM guess.
      - a real per-year frequency series for the top terms, and a
        growth_rate computed directly from that series (not estimated).
      - impact_weighted_frequency: each top term's total impact_score
        across papers containing it, not just a raw paper count — this
        surfaces terms concentrated in high-impact papers rather than
        just common ones.
      - co_occurrence: real counts of which top-term pairs appear
        together in the same paper.

    This is the "keywords used in the research papers, compared against
    current trends" input for the gap-detection LLM call — every number
    here comes from real counts; only the narrative interpretation of
    it is left to the LLM.
    """
    stopwords = stopwords or STOPWORDS_FALLBACK
    years = [y for y in (_paper_year(p) for p in papers) if y]
    if not years:
        return {'recent_keywords': [], 'established_keywords': [], 'declining_keywords': [],
                'rising_keywords': [], 'entrenched_keywords': [], 'cutoff_year': None,
                'year_wise_frequency': {}, 'growth_rate': {}, 'impact_weighted_frequency': [],
                'co_occurrence': [], 'keyword_categories': {'dataset': [], 'model': [], 'method': [],
                'application': [], 'general': []}, 'keyword_clusters': []}
    cutoff = max(years) - 1
    recent = [p for p in papers if (_paper_year(p) or 0) >= cutoff]
    established = [p for p in papers if (_paper_year(p) or 0) < cutoff]
    if not recent:
        recent, established = papers, []

    recent_counts = _text_tokens(recent, stopwords)
    established_counts = _text_tokens(established, stopwords)
    recent_top = [w for w, _ in recent_counts.most_common(top_n)]
    established_top = [w for w, _ in established_counts.most_common(top_n)]

    established_total = sum(established_counts.values()) or 1
    recent_total = sum(recent_counts.values()) or 1
    rising, entrenched = [], []
    for w in recent_top:
        recent_freq = recent_counts[w] / recent_total
        established_freq = established_counts.get(w, 0) / established_total
        (rising if recent_freq > established_freq * 1.5 else entrenched).append(w)
    declining = [w for w in established_top if w not in recent_top]

    # Union of terms worth tracking a real per-year series for.
    top_terms = list(dict.fromkeys(recent_top + established_top))

    year_wise_frequency = {}
    for term in top_terms:
        series = {}
        for p in papers:
            y = _paper_year(p)
            if y and _term_present(term, p):
                series[y] = series.get(y, 0) + 1
        if series:
            year_wise_frequency[term] = dict(sorted(series.items()))

    growth_rate = {}
    for term, series in year_wise_frequency.items():
        yrs = sorted(series.keys())
        if len(yrs) < 2:
            continue
        early_count, late_count = series[yrs[0]], series[yrs[-1]]
        growth_rate[term] = round((late_count - early_count) / max(1, early_count), 2)

    # Impact-weighted frequency: sum of impact_score (real for every
    # paper — citation-based where available, recency-only proxy
    # otherwise) across papers containing each term, instead of a bare
    # paper count. Surfaces terms concentrated in high-impact work.
    impact_weighted = Counter()
    for p in papers:
        score = p.get('impact_score', 0) or 0
        for term in top_terms:
            if _term_present(term, p):
                impact_weighted[term] += score
    impact_weighted_frequency = [{'term': t, 'weighted_score': round(s, 2)}
                                   for t, s in impact_weighted.most_common(15)]

    # Real co-occurrence counts — which term pairs actually appear
    # together in the same paper, not an inferred relationship.
    co_occurrence_counts = Counter()
    for p in papers:
        present = [t for t in top_terms if _term_present(t, p)]
        for i in range(len(present)):
            for j in range(i + 1, len(present)):
                co_occurrence_counts[tuple(sorted((present[i], present[j])))] += 1
    co_occurrence = [{'pair': list(pair), 'count': c} for pair, c in co_occurrence_counts.most_common(15)]

    # Stage-13 category buckets and stage-14 clusters — real,
    # pattern/graph-derived, not LLM-guessed (see categorize_keywords
    # and cluster_keywords docstrings above).
    keyword_categories = categorize_keywords(top_terms)
    keyword_clusters = cluster_keywords(co_occurrence)

    return {
        'recent_keywords': recent_top,
        'established_keywords': established_top,
        'rising_keywords': rising[:top_n],
        'entrenched_keywords': entrenched[:top_n],
        'declining_keywords': declining[:top_n],
        'cutoff_year': cutoff,
        'recent_paper_count': len(recent),
        'established_paper_count': len(established),
        'year_wise_frequency': year_wise_frequency,
        'growth_rate': growth_rate,
        'impact_weighted_frequency': impact_weighted_frequency,
        'co_occurrence': co_occurrence,
        'keyword_categories': keyword_categories,
        'keyword_clusters': keyword_clusters,
    }


def categorize_keyword(term):
    """
    Buckets a keyword/bigram into one of the flowchart's stage-13
    categories — Dataset / Model / Method / Application — using real
    lexical patterns (known dataset & model-family name fragments,
    common method/framework suffixes), never an LLM guess. Terms that
    don't match any pattern are 'general' rather than force-fit into
    a bucket that doesn't actually apply.
    """
    t = term.lower()
    dataset_markers = ('dataset', 'corpus', 'benchmark', 'imagenet', 'coco', 'mnist',
                        'squad', 'glue', 'wikitext', 'librispeech', 'kitti', 'cifar')
    model_markers = ('transformer', 'bert', 'gpt', 'cnn', 'rnn', 'lstm', 'gan', 'vae',
                      'diffusion', 'resnet', 'yolo', 'vit', 'autoencoder', 'attention',
                      'neural network', 'convolutional', 'llm', 'large language model')
    method_markers = ('algorithm', 'optimization', 'learning', 'framework', 'approach',
                       'method', 'technique', 'strategy', 'architecture', 'training',
                       'regression', 'classification', 'clustering algorithm')
    application_markers = ('detection', 'diagnosis', 'recognition', 'prediction',
                            'monitoring', 'management', 'system', 'application',
                            'healthcare', 'security', 'analysis', 'forecasting')

    if any(m in t for m in dataset_markers):
        return 'dataset'
    if any(m in t for m in model_markers):
        return 'model'
    if any(m in t for m in method_markers):
        return 'method'
    if any(m in t for m in application_markers):
        return 'application'
    return 'general'


def categorize_keywords(terms):
    """Returns {'dataset': [...], 'model': [...], 'method': [...],
    'application': [...], 'general': [...]} for a list of terms,
    preserving each term's original rank order within its bucket."""
    buckets = {'dataset': [], 'model': [], 'method': [], 'application': [], 'general': []}
    for term in terms:
        buckets[categorize_keyword(term)].append(term)
    return buckets


def cluster_keywords(co_occurrence, min_edge_count=2):
    """
    Groups top terms into clusters using real co-occurrence data: two
    terms are connected if they appear together in at least
    `min_edge_count` papers (see keyword_trend_stats' co_occurrence
    counts), and a cluster is a connected component of that graph —
    plain BFS over real edges, no embedding model or LLM involved.
    Singleton terms with no edge meeting the threshold are dropped
    (they aren't part of any real co-occurring cluster); terms never
    seen in co_occurrence at all are simply absent from the output.
    Returns a list of clusters, each a sorted list of terms, largest
    cluster first.
    """
    adjacency = {}
    for edge in co_occurrence:
        pair = edge.get('pair') or []
        count = edge.get('count', 0)
        if len(pair) != 2 or count < min_edge_count:
            continue
        a, b = pair
        adjacency.setdefault(a, set()).add(b)
        adjacency.setdefault(b, set()).add(a)

    visited = set()
    clusters = []
    for node in adjacency:
        if node in visited:
            continue
        queue = [node]
        component = set()
        while queue:
            cur = queue.pop()
            if cur in component:
                continue
            component.add(cur)
            queue.extend(adjacency.get(cur, ()) - component)
        visited |= component
        if len(component) > 1:
            clusters.append(sorted(component))
    clusters.sort(key=len, reverse=True)
    return clusters


# ─── Gap validation & prioritization ───────────────────────────────

def validate_and_prioritize_gaps(gaps, papers, trend_stats):
    """
    Adds a `validation` block to each LLM-returned gap, computed from
    real counts against the actual collected corpus rather than trusting
    the LLM's self-reported confidence_score alone:

      - evidence_paper_count: how many collected papers' title+abstract
        actually contain a term from the gap's own rising/entrenched
        keyword evidence, or match one of the gap's stated
        evidence_papers titles — a real overlap count, not the LLM's
        own tally.
      - oldest_evidence_year / most_recent_evidence_year: the real
        publication-year range of that matching evidence.
      - is_recently_active: whether any matching evidence was published
        within the corpus's most recent 2 years — a cheap, real
        "is this still being worked on" signal.
      - citation_links_among_evidence / evidence_appears_interconnected:
        a real citation-graph check (using Semantic Scholar's
        reference_titles and OpenAlex's referenced_works/openalex_id,
        wherever the corpus actually has them) for whether this gap's
        own matched evidence papers cite each other. Heavy interlinking
        suggests that pocket of literature is already well-connected and
        established; little or none among papers that independently
        surfaced for the same gap is a real (not LLM-guessed) novelty
        signal — these are pieces that exist but haven't been combined
        in the literature yet. Both fields are `None`, not `False`, when
        none of the matched papers carry any reference data at all —
        "no data" is never conflated with "checked and found nothing".

    Also strips `evidence_papers` down to titles that ACTUALLY EXIST in
    the collected corpus (architecture-review Phase 17/21): every title
    the LLM cited is checked with an exact normalized-title match
    against `papers`; a title that doesn't match anything real is
    removed from `evidence_papers` and recorded in
    `evidence_papers_unverified` instead, so a hallucinated citation
    can never render in the report as if it were real evidence. If
    EVERY cited title turns out to be unverifiable, the gap is kept
    (an LLM-proposed gap can be real even when its own citation list is
    bad) but `validation['all_evidence_papers_unverified']` is set True
    so the UI/report can flag it rather than silently show empty proof.

    Also computes a `priority_score` per gap: a transparent blend of the
    LLM's own confidence_score, the real evidence_paper_count/recency
    above, and a small interconnection adjustment (documented weights
    inline). This doesn't replace the LLM's judgment on novelty/
    feasibility — it grounds part of the final ranking in something
    checkable against the actual corpus instead of being pure LLM
    self-assessment. Sorts `gaps` in place by `priority_score` and
    stamps `priority_rank`; returns the same list.
    """
    if not gaps:
        return gaps
    corpus_years = [y for y in (_paper_year(p) for p in papers) if y]
    latest_year = max(corpus_years) if corpus_years else None
    recent_cutoff = (latest_year - 1) if latest_year else None
    known_terms = set(trend_stats.get('rising_keywords', [])) | set(trend_stats.get('entrenched_keywords', []))

    def cites(paper_a, paper_b):
        """True if paper_a's real reference list (Semantic Scholar
        titles, or OpenAlex referenced_works/openalex_id — whichever
        this paper actually has) includes paper_b, via an exact title or
        ID match — never a fuzzy guess."""
        b_title = _normalize_title(paper_b.get('title'))
        for ref_title in (paper_a.get('reference_titles') or []):
            if _normalize_title(ref_title) == b_title:
                return True
        b_oaid = paper_b.get('openalex_id')
        if b_oaid and b_oaid in (paper_a.get('referenced_works') or []):
            return True
        return False

    def evidence_terms_for_gap(gap):
        terms = set()
        signal = (gap.get('trend_signal') or '').lower()
        for kw in known_terms:
            if kw and kw in signal:
                terms.add(kw)
        for title in (gap.get('evidence_papers') or []):
            norm = _normalize_title(title)
            if norm:
                terms.add(norm)
        return terms

    corpus_titles_norm = {_normalize_title(p.get('title')) for p in papers if p.get('title')}

    for gap in gaps:
        # --- hard evidence-paper check (Phase 17/21): drop any cited
        # title that isn't an exact normalized match against a real
        # collected paper. Runs BEFORE evidence_terms_for_gap, so the
        # keyword/title matching below (which also reads
        # gap['evidence_papers']) only ever draws on verified titles too
        # — a hallucinated title can't sneak back in through that path
        # either.
        cited = list(gap.get('evidence_papers') or [])
        verified_titles, unverified_titles = [], []
        for title in cited:
            (verified_titles if _normalize_title(title) in corpus_titles_norm
             else unverified_titles).append(title)
        gap['evidence_papers'] = verified_titles
        gap['evidence_papers_unverified'] = unverified_titles

        terms = evidence_terms_for_gap(gap)
        matching_years, matched_papers = [], []
        if terms:
            for p in papers:
                title_norm = _normalize_title(p.get('title'))
                text = (p.get('title', '') + ' ' + p.get('abstract', '')).lower()
                if any((t and t in text) or (t and t == title_norm) for t in terms):
                    matched_papers.append(p)
                    y = _paper_year(p)
                    if y:
                        matching_years.append(y)

        # Bound the pairwise citation check for gaps with a large
        # evidence set — a real signal doesn't need to check every pair
        # among hundreds of matches to be meaningful.
        sample = matched_papers[:40]
        has_reference_data = any(p.get('reference_titles') or p.get('referenced_works') for p in sample)
        citation_links = 0
        if has_reference_data:
            for i in range(len(sample)):
                for j in range(len(sample)):
                    if i != j and cites(sample[i], sample[j]):
                        citation_links += 1

        # --- build the `validation` dict itself. This block was
        # missing from the original implementation — every field below
        # was referenced further down but never actually constructed,
        # which meant this function raised NameError on any non-empty
        # gap list. Fixed here; see the docstring above for what each
        # field means.
        oldest_evidence_year = min(matching_years) if matching_years else None
        most_recent_evidence_year = max(matching_years) if matching_years else None
        is_recently_active = bool(
            recent_cutoff and any(y >= recent_cutoff for y in matching_years))
        # "No reference data on any matched paper" and "checked and
        # found zero links" are different findings — None vs 0/False —
        # per the docstring's own honesty note.
        citation_links_among_evidence = citation_links if has_reference_data else None
        evidence_appears_interconnected = (
            (citation_links > 0) if has_reference_data else None)
        validation = {
            'evidence_paper_count': len(matched_papers),
            'oldest_evidence_year': oldest_evidence_year,
            'most_recent_evidence_year': most_recent_evidence_year,
            'is_recently_active': is_recently_active,
            'citation_links_among_evidence': citation_links_among_evidence,
            'evidence_appears_interconnected': evidence_appears_interconnected,
        }

        # Flowchart stage-18 explicit "is it already solved?" check —
        # a real (if necessarily heuristic) signal rather than an
        # LLM self-report: a gap whose own matched evidence is both
        # large relative to the corpus AND already densely
        # cross-cited AND still recently active looks like an active,
        # converging sub-literature — i.e. more "being actively
        # worked and connected" than "gap". Any one of those three
        # conditions missing keeps it False; `evidence_appears_interconnected`
        # being unknown (None, no reference data) also keeps it False —
        # "no data" is never treated as "solved".
        large_evidence = len(matched_papers) >= max(8, len(papers) * 0.03)
        appears_already_addressed = bool(
            large_evidence
            and validation['evidence_appears_interconnected'] is True
            and validation['is_recently_active']
        )
        validation['appears_already_addressed'] = appears_already_addressed
        validation['evidence_papers_cited'] = len(cited)
        validation['evidence_papers_verified'] = len(verified_titles)
        validation['evidence_papers_dropped'] = len(unverified_titles)
        validation['all_evidence_papers_unverified'] = bool(cited) and not verified_titles
        gap['validation'] = validation

        confidence = (gap.get('confidence_score') or 0) / 100.0
        evidence_norm = min(1.0, len(matched_papers) / max(10, len(papers) * 0.02))
        recency_bonus = 0.15 if validation['is_recently_active'] else 0.0
        # Small, documented nudge: real evidence that exists but hasn't
        # been cross-cited yet is a slightly stronger real novelty signal
        # than evidence that's already densely self-citing (the
        # connection has plausibly already been made in the literature).
        # Never dominant — capped at ±0.05 against confidence's 0.5 weight.
        interconnection_adjustment = 0.0
        if validation['evidence_appears_interconnected'] is False and len(matched_papers) >= 2:
            interconnection_adjustment = 0.05
        elif validation['evidence_appears_interconnected'] is True:
            interconnection_adjustment = -0.05
        # A larger, explicit penalty (not just the interconnection nudge
        # above) when the gap looks already-addressed by all three
        # signals at once — this is meant to visibly de-rank those
        # gaps rather than just slightly discount them.
        already_addressed_penalty = 0.25 if appears_already_addressed else 0.0
        gap['priority_score'] = round(100 * max(0.0, 0.5 * confidence + 0.35 * evidence_norm
                                                  + recency_bonus + interconnection_adjustment
                                                  - already_addressed_penalty), 1)

    gaps.sort(key=lambda g: g.get('priority_score', 0), reverse=True)
    for rank, gap in enumerate(gaps, start=1):
        gap['priority_rank'] = rank
    return gaps