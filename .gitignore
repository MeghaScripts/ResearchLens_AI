# Environment / secrets
.env
.env.*
*.pem
*.key

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
venv/
env/
.venv/

# Flask / project data
*.db
*.sqlite
*.sqlite3
instance/

# Generated content
uploads/
reports/*.pdf

# Firebase
serviceAccountKey.json
firebase-debug.log

# Editor / OS junk
.vscode/
.idea/
.DS_Store
*.log

@"
.env
__pycache__/
venv/
*.pyc
*.bak
*.bak-*
backend/apply_*.py
backend/fix_*.py
"@ | Out-File -Encoding utf8 .gitignore
# Backups and one-off patch scripts
*.bak
*.bak-*
backend/apply_*.py
backend/fix_*.py

# Verification evaluation artefacts (regenerate with python -m eval.build_eval_set / eval.run_eval)
backend/eval/registry_cache.json
backend/eval/results.json
*.bak
