rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
//
// Previously this project had NO firestore.rules file checked in at all,
// which (depending on how the project was created) most likely meant it
// was running on Firebase's default test-mode rules — open read/write to
// anyone, indefinitely. Combined with the client writing OTPs and
// generated passwords straight into `otps` and `userPasswords`
// collections, that meant anyone with the (public, embeddable) Firebase
// web config could read every pending OTP and every generated password
// directly from the browser console, with no server involved at all.
//
// login.html no longer uses the otps/userPasswords collections (it uses
// Firebase's built-in passwordless email-link sign-in instead), so there
// are intentionally no rules for them below — default-deny covers them.
// If those collections still contain data from before this fix, delete
// them from the Firebase console; do not rely on rules alone to protect
// data that shouldn't have been written in the first place.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user may read/write only their own profile document, and only
    // once they're signed in. No one — including other signed-in users —
    // can read another user's profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
